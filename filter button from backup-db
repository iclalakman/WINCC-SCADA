Sub OnClick(Byval Item)         
Dim conn, rs, strConn, strSQL
Dim dtStart, dtEnd, sStartUTC, sEndUTC
Dim oList, oItem, listItem
Dim valID, rVal, quality, qStatus
Dim objStartDate, objStartTime, objEndDate, objEndTime
Dim tagIDs, idCount, rawStamp, strDate, strTime, dtLocal, sFormattedTime
Dim dict, tKey, rowData, k, rawRealVal, colIdx, rowCount
Dim selectedTagsArray, selectedIDsArray, arrIdx
Dim counts, sums, mins, maxs

' Step 1 : Connecting the date, time and listview controls on the graphic designer
    Set objStartDate = ScreenItems("start_date")
    Set objStartTime = ScreenItems("start_time")
    Set objEndDate   = ScreenItems("end_date")
    Set objEndTime   = ScreenItems("end_time")
    Set oList        = ScreenItems("list_data") 

 ' Step 2: Merge the date and time together
    On Error Resume Next
    dtStart = DateValue(objStartDate.Value) + TimeValue(objStartTime.Value)
    dtEnd   = DateValue(objEndDate.Value) + TimeValue(objEndTime.Value)

    If Err.Number <> 0 Then
        MsgBox "Date-Time Reading Error! Please check the names of the objects: " & Err.Description, vbCritical, "Error"
        Exit Sub
    End If
    On Error GoTo 0

 ' Step 3: Due to my time zone is +3, I had to subtract the 3 hours than usual from WINCC
    dtStart = DateAdd("h", -3, dtStart)
    dtEnd   = DateAdd("h", -3, dtEnd)

 ' Step 4: Converting to the SQL format (YYYY-MM-DD HH:MM:SS.000)
    sStartUTC = Year(dtStart) & "-" & Right("0" & Month(dtStart), 2) & "-" & Right("0" & Day(dtStart), 2) & " " & _
                Right("0" & Hour(dtStart), 2) & ":" & Right("0" & Minute(dtStart), 2) & ":" & Right("0" & Second(dtStart), 2) & ".000"

    sEndUTC   = Year(dtEnd) & "-" & Right("0" & Month(dtEnd), 2) & "-" & Right("0" & Day(dtEnd), 2) & " " & _
                Right("0" & Hour(dtEnd), 2) & ":" & Right("0" & Minute(dtEnd), 2) & ":" & Right("0" & Second(dtEnd), 2) & ".000"

' Step 5: Retrieving the data of list_data (for tag choice-selection)
    tagIDs = ""
    idCount = 0

' We will count how many tag has been selected
    For Each listItem In oList.ListItems
        If listItem.Checked Then
            idCount = idCount + 1
        End If
    Next

    If idCount = 0 Then
        MsgBox "Please choose the tags from list_data for filtered query!", vbExclamation, "Warning"
        Exit Sub
    End If

  ' We will match the tagID's with their tag names into the arrays for the chosen ones.
    ReDim selectedIDsArray(idCount - 1)
    ReDim selectedTagsArray(idCount - 1)

    arrIdx = 0
    For Each listItem In oList.ListItems
        If listItem.Checked Then
            selectedIDsArray(arrIdx) = CLng(listItem.Text)
            selectedTagsArray(arrIdx) = listItem.SubItems(1)
            tagIDs = tagIDs & listItem.Text & ","
            arrIdx = arrIdx + 1
        End If
    Next

    tagIDs = Left(tagIDs, Len(tagIDs) - 1)
    tagIDs = "(" & tagIDs & ")"

    ' Step 6: Database Connection
    On Error Resume Next
    Err.Clear
    strConn = "Provider=SQLOLEDB;Data Source=.\WINCC;Initial Catalog=backup-wincc;Integrated Security=SSPI;"
    Set conn = CreateObject("ADODB.Connection")
    conn.Open strConn

    If Err.Number <> 0 Then
        MsgBox "Database Connection Error: " & Err.Description, vbCritical, "Error"
        Exit Sub
    End If

    ' Step 7: SQL QUERY
    strSQL = "SELECT TagID, Timestamp, TagValue, QualityCode FROM dbo.HistoryTagLogs " & _
             "WHERE TagID IN " & tagIDs & " " & _
             "AND Timestamp BETWEEN '" & sStartUTC & "' AND '" & sEndUTC & "' " & _
             "ORDER BY Timestamp ASC"

    Set rs = CreateObject("ADODB.Recordset")
    rs.Open strSQL, conn

    If Err.Number <> 0 Then
        MsgBox "Query Error (HistoryTagLogs): " & Err.Description, vbCritical, "Error"
        conn.Close
        Exit Sub
    End If

    ' Step 8: Creating list_data columns
    oList.ListItems.Clear
    oList.ColumnHeaders.Clear
    oList.ColumnHeaders.Add 1, "hTime", "Date / Time", 140

    Dim colCounter
    colCounter = 2
    For k = 0 To idCount - 1
        oList.ColumnHeaders.Add colCounter, "col_" & selectedIDsArray(k), selectedTagsArray(k), 100
        colCounter = colCounter + 1
        oList.ColumnHeaders.Add colCounter, "q_" & selectedIDsArray(k), selectedTagsArray(k) & " Quality", 90
        colCounter = colCounter + 1
    Next

    ' Step 9: Init Statistics
    ReDim counts(idCount - 1)
    ReDim sums(idCount - 1)
    ReDim mins(idCount - 1)
    ReDim maxs(idCount - 1)

    For k = 0 To idCount - 1
        counts(k) = 0
        sums(k) = 0.0
        mins(k) = 999999.0
        maxs(k) = -999999.0
    Next

    ' Step 10: Fetching and Grouping Data
    Set dict = CreateObject("Scripting.Dictionary")
    Dim currentFields

    Do While Not rs.EOF
        rawStamp = CStr(rs.Fields("Timestamp").Value)

        If InStr(rawStamp, " ") > 0 Then
            strDate = Left(rawStamp, InStr(rawStamp, " ") - 1)
            strTime = Mid(rawStamp, InStr(rawStamp, " ") + 1, 8)

            dtLocal = DateAdd("h", 3, CDate(strDate & " " & strTime))
            sFormattedTime = Year(dtLocal) & "-" & Right("0" & Month(dtLocal), 2) & "-" & Right("0" & Day(dtLocal), 2) & " " & _
                             Right("0" & Hour(dtLocal), 2) & ":" & Right("0" & Minute(dtLocal), 2) & ":" & Right("0" & Second(dtLocal), 2)
        Else
            sFormattedTime = rawStamp
        End If

        valID = CLng(rs.Fields("TagID").Value)
        rawRealVal = CDbl(rs.Fields("TagValue").Value)
        rVal  = FormatNumber(rawRealVal, 2)
        
        quality = CLng(rs.Fields("QualityCode").Value)

        If quality = 0 Then
            qStatus = "bad (0x00)"
        ElseIf quality = 4 Then
            qStatus = "bad (0x04)"
        ElseIf quality = 8 Then
            qStatus = "bad (0x08)"
        ElseIf quality = 12 Then
            qStatus = "bad (0x0C)"
        ElseIf quality = 20 Then
            qStatus = "bad (0x14)"
        ElseIf quality = 24 Then
            qStatus = "bad (0x18)"
        ElseIf quality = 28 Then
            qStatus = "bad (0x1C)"
        ElseIf quality = 40 Then
            qStatus = "bad (0x28)"
        ElseIf quality = 43 Then
            qStatus = "bad (0x2B)"
        ElseIf quality = 64 Then
            qStatus = "uncertain (0x40)"
        ElseIf quality = 68 Then
            qStatus = "uncertain (0x44)"
        ElseIf quality = 72 Then
            qStatus = "uncertain (0x48)"
        ElseIf quality = 76 Then
            qStatus = "uncertain (0x4C)"
        ElseIf quality = 84 Then
            qStatus = "uncertain (0x54)"
        ElseIf quality = 96 Then
            qStatus = "uncertain (0x60)"
        ElseIf quality = 104 Then
            qStatus = "uncertain (0x68)"
        ElseIf quality = 120 Then
            qStatus = "uncertain (0x78)"
        ElseIf quality = 128 Then
            qStatus = "good (0x80)"
        ElseIf quality = 192 Then
            qStatus = "good (0xC0)"
        Else
            qStatus = "Unknown (" & quality & ")"
        End If

        ' Eğer bu tarih ilk defa geldiyse boş dizi oluştur
        If Not dict.Exists(sFormattedTime) Then
            ReDim rowData( (idCount * 2) - 1 )
            For k = 0 To UBound(rowData)
                rowData(k) = ""
            Next
            dict.Add sFormattedTime, rowData
        End If
        
        ' ** KRİTİK DÜZELTME ** WinCC VBScript için dizi referansını yenileyerek atama yapıyoruz
        currentFields = dict.Item(sFormattedTime)
        
        For k = 0 To idCount - 1
            If CLng(selectedIDsArray(k)) = valID Then
                currentFields(k * 2) = rVal
                currentFields((k * 2) + 1) = qStatus
                
                counts(k) = counts(k) + 1
                sums(k) = sums(k) + rawRealVal
                If rawRealVal < mins(k) Then mins(k) = rawRealVal
                If rawRealVal > maxs(k) Then maxs(k) = rawRealVal
                Exit For
            End If
        Next
        
        ' Güncellenen diziyi dictionary nesnesine geri yüklüyoruz
        dict.Item(sFormattedTime) = currentFields

        rs.MoveNext
    Loop

    rs.Close
    conn.Close

    ' ------------------------------------------------------------------------------------------
    ' 1. VERİTABANINDAN GELEN DETAY (ZAMAN SERİSİ) SATIRLARINI LİSTEYE AKTARMA (ÖNCE YAZILIR)
    ' ------------------------------------------------------------------------------------------
    Dim allKeys, allItems, i
    allKeys = dict.Keys
    allItems = dict.Items

    For i = 0 To dict.Count - 1
        Set listItem = oList.ListItems.Add(, , CStr(allKeys(i)))
        rowData = allItems(i)
        
        For k = 0 To UBound(rowData)
            listItem.SubItems(k + 1) = rowData(k)
        Next
    Next

    ' ------------------------------------------------------------------------------------------
    ' 2. İSTATİSTİK SATIRLARINI EKLEME (EN SONA TAŞINDI)
    ' ------------------------------------------------------------------------------------------
    Dim itemAvg
    
    ' BOŞLUK SATIRI (Verilerle istatistikler karışmasın diye görsel ayrım)
    oList.ListItems.Add , , "------------------"

    ' COUNT Satırı
    Set listItem = oList.ListItems.Add(, , "COUNT")
    For k = 0 To idCount - 1
        listItem.SubItems(k * 2 + 1) = CStr(counts(k))
    Next

    ' AVERAGE Satırı
    Set listItem = oList.ListItems.Add(, , "AVERAGE")
    For k = 0 To idCount - 1
        If counts(k) > 0 Then
            itemAvg = sums(k) / counts(k)
            listItem.SubItems(k * 2 + 1) = FormatNumber(itemAvg, 2)
        Else
            listItem.SubItems(k * 2 + 1) = "0.00"
        End If
    Next

    ' MINIMUM Satırı
    Set listItem = oList.ListItems.Add(, , "MINIMUM")
    For k = 0 To idCount - 1
        If mins(k) = 999999.0 Then mins(k) = 0.0
        listItem.SubItems(k * 2 + 1) = FormatNumber(mins(k), 2)
    Next

    ' MAXIMUM Satırı
    Set listItem = oList.ListItems.Add(, , "MAXIMUM")
    For k = 0 To idCount - 1
    If maxs(k) = -999999.0 Then maxs(k) = 0.0
    listItem.SubItems(k * 2 + 1) = FormatNumber(maxs(k), 2)
    Next


End Sub
