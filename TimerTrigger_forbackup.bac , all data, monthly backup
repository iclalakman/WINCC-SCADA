Option Explicit
Function action
    Dim conn, strSQL
    Dim strConn, sStartUTC, sEndUTC
    Dim dtStart, dtEnd
    
    'Enable the error message for in case of corruption of script during runtime logs
    On Error Resume Next

    dtEnd = Now
    'For daily write "d"
    'For weekly write "ww"
    'For monthly write "m"
    dtStart = DateAdd("m", -1, dtEnd) 
    
    'Extract 3 hours due to UTC and WINCC's local time discrepancy
    dtStart = DateAdd("h", -3, dtStart)
    dtEnd   = DateAdd("h", -3, dtEnd)
    
    'Correct format of date and time for SQL Server ve WinCC OLEDB (YYYY-MM-DD HH:MM:SS.000)
    sStartUTC = Year(dtStart) & "-" & Right("0" & Month(dtStart), 2) & "-" & Right("0" & Day(dtStart), 2) & " " & _
                Right("0" & Hour(dtStart), 2) & ":" & Right("0" & Minute(dtStart), 2) & ":" & Right("0" & Second(dtStart), 2) & ".000"

    sEndUTC   = Year(dtEnd) & "-" & Right("0" & Month(dtEnd), 2) & "-" & Right("0" & Day(dtEnd), 2) & " " & _
                Right("0" & Hour(dtEnd), 2) & ":" & Right("0" & Minute(dtEnd), 2) & ":" & Right("0" & Second(dtEnd), 2) & ".000"

    
    'Database connection local wincc instance 
    strConn = "Provider=SQLOLEDB;Data Source=.\WINCC;Initial Catalog=backup-wincc;Integrated Security=SSPI;"
    Set conn = CreateObject("ADODB.Connection")
    conn.Open strConn

    
    'Connection control and trigger of SQL query
    If Err.Number <> 0 Then
        HMIRuntime.Trace "Error: Connection error with database! " & Err.Description & vbCrLf
    Else
        HMIRuntime.Trace "Back up information: Connection is successful. SQL query has been triggered" & vbCrLf
        HMIRuntime.Trace "Query time interval (UTC): " & sStartUTC & " ile " & sEndUTC & vbCrLf

        'Search the all tags that has been created using loop
        strSQL = "EXEC dbo.Sp_WinCC_AllTags_Backup '" & sStartUTC & "', '" & sEndUTC & "'"
        conn.Execute strSQL

        'Error handling of whether error occured 
        If Err.Number <> 0 Then
            HMIRuntime.Trace "Back up Error: SQL query i! Error: " & Err.Description & vbCrLf
        Else
            HMIRuntime.Trace "Back up is successful: All data was copied in secure environment!" & vbCrLf
        End If
        
        'Close the connection safely
        conn.Close
    End If

    'Clean up and refresh the memory
    Set conn = Nothing
    On Error GoTo 0

End Function
