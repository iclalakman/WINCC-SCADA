Sub OnClick(ByVal Item)                  
Dim conn, rs, strConn, strSQL, oList, oItem, tagName, tagID, rowCount, slashPos, cleanName

    ' Step 1: Connecting the list_data which is ActiveX ListView Object
    Set oList = ScreenItems("list_data")
    If oList Is Nothing Then
        MsgBox "Error: There is no ListView object on the screen named list_data !", vbCritical, "Error"
        Exit Sub
    End If

    ' Deleting old data and refreshing the list_data(ListView) 
    oList.ListItems.Clear
    oList.ColumnHeaders.Clear

    ' Standart WinCC ListView Display Settings
    oList.View = 3
    oList.GridLines = True
    oList.FullRowSelect = True
   
    ' Updating column's headers
    oList.ColumnHeaders.Add 1, "colID", "Tag ID", 70
    oList.ColumnHeaders.Add 2, "colName", "Tag Name", 350

    ' Step 2: Connecting SQL Server with Microsoft Standard SQL Driver directly 
    On Error Resume Next
    Err.Clear
    strConn = "Provider=SQLOLEDB;Data Source=.\WINCC;Initial Catalog=CC_iclal_pr_26_08_10_15_06_04R;Integrated Security=SSPI;"
    Set conn = CreateObject("ADODB.Connection")
    conn.Open strConn

    If Err.Number <> 0 Then
        MsgBox "SQL Driver Connection Error!: " & Err.Description, vbCritical, "Error"
        Exit Sub
    End If

    'Step 3: The query that extracting the tags from dbo.Archivetable 
    strSQL = "SELECT ValueID, ValueName FROM [CC_iclal_pr_26_08_10_15_06_04R].[dbo].[Archive] ORDER BY ValueID ASC"
    Set rs = CreateObject("ADODB.Recordset")
    rs.Open strSQL, conn, 1, 1

    If Err.Number <> 0 Then
        MsgBox "SQL Query Error: " & Err.Description, vbCritical, "Error"
        conn.Close
        Exit Sub
    End If

    ' Step 4. This loop will be executed number of tags, it will pick the matching ValueNames and print the list_data
    rowCount = 1
    If Not (rs.BOF And rs.EOF) Then
        rs.MoveFirst
        Do While Not rs.EOF
            tagID = Trim(CStr(rs.Fields("ValueID").Value))
            tagName = Trim(CStr(rs.Fields("ValueName").Value))
           
            If tagName <> "" Then
                ' Instead of getting every tag's archieves, Iclal_archive\Pressure, we will just need Pressure part , not Iclal_archieve
                slashPos = InStrRev(tagName, "\")
               
                If slashPos > 0 Then
                    'If there is \, we will get the right side
                    cleanName = Mid(tagName, slashPos + 1)
                Else
                    ' If there is no \, we will keep as it is
                    cleanName = tagName
                End If
                ' ----------------------------------------
               
                ' Printing the data into list_data(ListView)
                Set oItem = oList.ListItems.Add(rowCount, , tagID)
                oItem.SubItems(1) = cleanName
               
                rowCount = rowCount + 1
            End If
           
            rs.MoveNext
        Loop
       
        oList.Refresh ' Forcing the tablo keeping it up to date
    Else
        MsgBox "There is no tag found int the SQL table!", vbExclamation, "Warning"
    End If

    ' Step 5: Closing the connections safely and clean up of the memory
    rs.Close
    conn.Close
    Set oItem = Nothing
    Set rs = Nothing
    Set conn = Nothing

End Sub
