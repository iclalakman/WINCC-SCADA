 USE [backup-wincc]
GO

IF OBJECT_ID('dbo.Sp_WinCC_AllTags_Backup', 'P') IS NOT NULL
    DROP PROCEDURE dbo.Sp_WinCC_AllTags_Backup;
GO

CREATE PROCEDURE dbo.Sp_WinCC_AllTags_Backup
    @StartTime VARCHAR(30),
    @EndTime VARCHAR(30)
AS
BEGIN
    SET NOCOUNT ON;
    
    DECLARE @CurrentTagID INT;
    DECLARE @DynamicSQL NVARCHAR(MAX);

    -- TagDefinitions tablosundaki tüm tag tanımlarını dönüyoruz
    DECLARE Tag_Cursor CURSOR FOR 
    SELECT TagID FROM [backup-wincc].[dbo].[TagDefinitions] ORDER BY TagID;

    OPEN Tag_Cursor;
    FETCH NEXT FROM Tag_Cursor INTO @CurrentTagID;

    WHILE @@FETCH_STATUS = 0
    BEGIN
        -- Hataları gizleyen TRY/CATCH blokları tamamen kaldırıldı!
        -- Böylece hangi tag patlıyorsa hatasını ekranda doğrudan göreceğiz.
        SET @DynamicSQL = N'
            INSERT INTO [backup-wincc].[dbo].[HistoryTagLogs] (TagID, Timestamp, TagValue, QualityCode)
            SELECT CAST(' + CAST(@CurrentTagID AS VARCHAR(10)) + ' AS INT), [Timestamp], CAST([RealValue] AS FLOAT), CAST([Quality] AS INT)
            FROM OPENQUERY(LnkRtDb_WinCCOLEDB, ' + CHAR(39) + 'TAG:R,' + CAST(@CurrentTagID AS VARCHAR(10)) + ',' + CHAR(39) + CHAR(39) + @StartTime + CHAR(39) + CHAR(39) + ',' + CHAR(39) + CHAR(39) + @EndTime + CHAR(39) + CHAR(39) + CHAR(39) + ')
            WHERE NOT EXISTS (
                SELECT 1 FROM [backup-wincc].[dbo].[HistoryTagLogs] sub 
                WHERE sub.TagID = CAST(' + CAST(@CurrentTagID AS VARCHAR(10)) + ' AS INT) AND sub.Timestamp = [Timestamp]
            )';

        -- Sorguyu doğrudan yürütüyoruz (Hata fırlatması için)
        EXEC sp_executesql @DynamicSQL;

        FETCH NEXT FROM Tag_Cursor INTO @CurrentTagID;
    END

    CLOSE Tag_Cursor;
    DEALLOCATE Tag_Cursor;
END
GO

